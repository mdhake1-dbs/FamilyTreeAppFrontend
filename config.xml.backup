<?xml version='1.0' encoding='utf-8'?>
<widget id="com.familytree.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Family Tree Manager</name>
    <description>A comprehensive family tree management application</description>
    <author email="support@familytree.com" href="https://familytree.com">
        Family Tree Team
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidPersistentFileLocation" value="Internal" />
    </platform>
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackupWebStorage" value="local" />
    <preference name="StatusBarBackgroundColor" value="#1F4E78" />
    <plugin name="cordova-plugin-statusbar" source="npm" />
    <plugin name="cordova-plugin-splashscreen" source="npm" />
</widget>
