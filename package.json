{
  "name": "com.familytree.app",
  "displayName": "Family Tree Manager",
  "version": "1.0.0",
  "description": "A comprehensive family tree management application",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
